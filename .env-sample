##############################################################
# Example configuration for Besu Private Chain noderunner app on AWS #
##############################################################

# Set the AWS account id and region for your environment
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Private Chain Configuration
VALIDATOR_INSTANCE_TYPE="c7g.2xlarge"
BESU_MEMORY_LIMIT_GB=12                 # MUST be less than the instance type's memory size.
NUM_VALIDATORS=4                        
ALLOWED_RPC_APIS='ETH,NET,IBFT,ADMIN,TXPOOL'
SHARD=3

# Cross-account peer configuration (optional)
ENABLE_CROSS_ACCOUNT_PEER="false"
CROSS_ACCOUNT_PEER_CIDR="10.70.0.0/16"
DEPLOY_ACCOUNT_B_PEER_NODE="false"
TRANSIT_GATEWAY_ID=""
ACCOUNT_B_AWS_ACCOUNT_ID=""
ACCOUNT_B_AWS_REGION="us-east-1"
PEER_VPC_CIDR="10.70.0.0/16"
VALIDATOR_VPC_CIDR="10.60.0.0/16"
CONFIG_BUCKET_ARN=""
CONFIG_BUCKET_KEY_ARN=""
CONFIG_BUCKET_PREFIX=""
GENESIS_OBJECT_KEY=""
STATIC_NODES_OBJECT_KEY=""
PEER_INSTANCE_TYPE="c6i.large"

# For more detailed configuration options
# see /lib/constants and /lib/genesis/genesis.json
